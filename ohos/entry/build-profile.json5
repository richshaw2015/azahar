{
  "apiType": "stageMode",
  "buildOption": {
    "resOptions": {
      "copyCodeResource": {
        "enable": false
      }
    },
    "externalNativeOptions": {
      "path": "../../CMakeLists.txt",
      "arguments": "-DOHOS_STL=c++_shared -DCMAKE_BUILD_TYPE=Release -DENABLE_OHOS=ON -DENABLE_OHOS_TESTS=ON -DARCHITECTURE=arm64",
      "cppFlags": "-std=c++20",
      "abiFilters": [
        "arm64-v8a"
      ]
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      },
      "nativeLib": {
        "debugSymbol": {
          "strip": true,
          "exclude": []
        }
      }
    },
  ],
  "targets": [
    {
      "name": "default",
      "runtimeOS": "HarmonyOS"
    },
    {
      "name": "release",
      "runtimeOS": "HarmonyOS",
      "config": {
        "buildOption": {
          "externalNativeOptions": {
            "path": "../../CMakeLists.txt",
            "arguments": "-DOHOS_STL=c++_shared -DCMAKE_BUILD_TYPE=Release -DENABLE_OHOS=ON -DENABLE_OHOS_TESTS=OFF -DARCHITECTURE=arm64",
            "cppFlags": "-std=c++20",
            "abiFilters": [
              "arm64-v8a"
            ]
          }
        }
      }
    }
  ]
}
